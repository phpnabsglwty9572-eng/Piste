	<string>The microphone is used for voice in calls and messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photos are used when you choose an avatar, a profile background, or a post.</string>
	<key>UIAppFonts</key>
	<array>
		<string>ADLaMDisplay-Regular.ttf</string>
		<string>BakbakOne-Regular.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
	</array>
